<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_exports_report_template_list" model="ir.ui.view">
        <field name="name">exports.report.template.list</field>
        <field name="model">exports.report.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_builtin"/>
                <field name="required_metric_keys"/>
                <field name="required_block_keys"/>
            </list>
        </field>
    </record>

    <record id="view_exports_report_template_form" model="ir.ui.view">
        <field name="name">exports.report.template.form</field>
        <field name="model">exports.report.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="is_builtin"/>
                        <field name="xlsx_template" filename="xlsx_template_filename" readonly="is_builtin"/>
                        <field name="xlsx_template_filename" invisible="1"/>
                        <field name="is_builtin" readonly="1"/>
                        <field name="builtin_source" readonly="1" invisible="not is_builtin"/>
                        <field name="active"/>
                    </group>
                    <group string="Detected placeholders">
                        <field name="required_metric_keys"/>
                        <field name="required_block_keys"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_exports_report_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">exports.report.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
